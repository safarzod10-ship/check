; Engine configuration file.
; DUSHANBE-X — open world, Godot 4.4

config_version=5

[application]

config/name="DUSHANBE-X"
config/description="Открытый 3D-мир, вдохновлённый Душанбе и горами Таджикистана"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "Mobile")
boot_splash/bg_color=Color(0.06, 0.08, 0.12, 1)
config/icon="res://icon.svg"

[autoload]

WorldData="*res://autoload/world_data.gd"
GameSettings="*res://autoload/game_settings.gd"
TimeWeather="*res://autoload/time_weather.gd"
GameState="*res://autoload/game_state.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4
window/energy_saving/keep_screen_on=true

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

common/physics_ticks_per_second=60
3d/physics_engine="Jolt Physics"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
rendering_device/fallback_to_opengl3=true
textures/vram_compression/import_etc2_astc=true
textures/default_filters/anisotropic_filtering_level=2
lights_and_shadows/directional_shadow/size=2048
lights_and_shadows/directional_shadow/size.mobile=2048
lights_and_shadows/directional_shadow/soft_shadow_filter_quality.mobile=1
lights_and_shadows/positional_shadow/atlas_size.mobile=1024
environment/defaults/default_clear_color=Color(0.55, 0.7, 0.9, 1)
occlusion_culling/use_occlusion_culling=true
anti_aliasing/quality/msaa_3d=1
limits/opengl/max_renderable_lights=16

[shader_globals]

wetness={
"type": "float",
"value": 0.0
}
night_factor={
"type": "float",
"value": 0.0
}
wind_strength={
"type": "float",
"value": 0.3
}
player_pos={
"type": "vec3",
"value": Vector3(0, 0, 0)
}
snow_line={
"type": "float",
"value": 1450.0
}
