(slice, slice, int) $SomoraTreasury$_contract_load() impure inline {
    slice $sc = get_data().begin_parse();
    int $loaded = $sc~load_int(1);
    if ($loaded) {
        return $sc~$SomoraTreasury$_load();
    }
    else {
        (slice $owner, int $rate) = $sc~$SomoraTreasury$init$_load();
        $sc.end_parse();
        return $SomoraTreasury$_contract_init($owner, $rate);
    }
}

